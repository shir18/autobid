<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE review_catalog [
  <!ELEMENT review_catalog (review+)>
  <!ELEMENT review (title, reviewer, category, release_year)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT reviewer (#PCDATA)>
  <!ELEMENT category (#PCDATA)>
  <!ELEMENT release_year (#PCDATA)>
  <!-- Note: DTD cannot inherently restrict #PCDATA to exactly four digits. 
       To enforce a 4-digit year, one must use XML Schema (XSD) instead of DTD, 
       or handle the validation at the application level. -->
]>
<review_catalog>
  <review>
    <title>Mahindra Thar ROXX Detailed Review</title>
    <reviewer>Faisal Khan</reviewer>
    <category>SUV</category>
    <release_year>2024</release_year>
  </review>
  <review>
    <title>Honda Elevate Drive Impressions</title>
    <reviewer>Autocar India</reviewer>
    <category>Compact SUV</category>
    <release_year>2023</release_year>
  </review>
</review_catalog>
